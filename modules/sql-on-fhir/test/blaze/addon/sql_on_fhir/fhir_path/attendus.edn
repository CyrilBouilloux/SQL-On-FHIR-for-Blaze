;; Attendus FHIRPath de F-004 / T-006 — ORACLE, ecrit par `testeur`.
;; L'executant du code (clojure-engineer) ne modifie JAMAIS ce fichier : un ecart
;; entre ce fichier et le code se resout dans le code, ou s'escalade (jamais ici).
;;
;; Lu le 2026-10-09 : chaque :extrait est une citation EXACTE (blancs normalises)
;; du document cite par :doc, ouvert ce jour. Pas de memoire, pas de Blaze.
;;
;; Forme d'un attendu :
;;   {:collection [{:type "System.X" :valeur v} ...]}  resultat FHIRPath (une collection) ;
;;                                                      [] = vide ; les temporels s'ecrivent en ISO 8601
;;   {:anomalie {:categorie :incorrect :message-contient ["..."]}}  erreur signalee a l'appelant
;;   {:relation ...}  opaque par la specification : seule la relation est attendue
;; :entree = cle de :sondes ; :constantes = constantes de la vue (ViewDefinition.constant) ;
;; :contexte = etat fourni par le calcul de vue (hors ressource).
;; :niveau-source = :texte (la section dit le resultat) | :derive (resultat deduit
;; de la section, ecart signale) — les :derive sont listes dans le compte rendu T-006.
{:sources
 {:fp-n1        {:titre "FHIRPath N1 (page intitulee « Normative Release (v2.0.0) »)" :url "https://hl7.org/fhirpath/N1/"}
  :fp-ci        {:titre "FHIRPath v3.0.0-ballot (join, lowBoundary, highBoundary : pas dans N1)" :url "https://hl7.org/fhirpath/2025Jan/"}
  :sof-vd       {:titre "SQL on FHIR 2.1.0-pre, page ViewDefinition (generee le 2026-05-21)" :url "https://build.fhir.org/ig/FHIR/sql-on-fhir-v2/StructureDefinition-ViewDefinition.html"}
  :sof-vd-json  {:titre "SQL on FHIR 2.1.0-pre, StructureDefinition ViewDefinition (JSON)" :url "https://build.fhir.org/ig/FHIR/sql-on-fhir-v2/StructureDefinition-ViewDefinition.json"}
  :fhir-r4      {:titre "FHIR R4, FHIRPath" :url "https://hl7.org/fhir/R4/fhirpath.html"}
