# versions.env — source unique des versions de blaze-platform.
#
# Regle absolue : aucune reference a `latest`, nulle part. Aucun numero ailleurs
# qu'ici : le chart les DERIVE (kubernetes/chart/deriver.sh, a adapter).
# Une entree non encore relevee est COMMENTEE, jamais vide : une entree vide est
# comptee comme manquante par scripts/check_versions.py.
# Chaque valeur porte la date et la source de son releve, jamais la memoire.

FHIR_VERSION=R4

# --- Pile servie (ADR 0001) ---
# samply/blaze — derniere publication au 2026-10-07, publiee le 2026-08-23 :
#   curl -s https://api.github.com/repos/samply/blaze/releases?per_page=1
# Etiquette d IMAGE, sans le « v » du tag Git (docs/deployment.md amont :
# `tag = release.substring(1)`). Le meme numero etiquette samply/blaze-frontend.
# Etiquettes verifiees presentes sur Docker Hub le 2026-10-07 :
#   curl -s https://hub.docker.com/v2/repositories/samply/<image>/tags/1.11.0
# Blaze recommande d'epingler aussi l'EMPREINTE (docs/deployment.md amont) —
# point ouvert 8 de l'ADR 0001. Empreintes relevees par la meme commande, NON
# retenues comme cles tant que le point n'est pas tranche :
#   samply/blaze           sha256:7b85c55df66122061abade67c715959b38508bb74bc28f62f262771e00f9a66c
#   samply/blaze-frontend  sha256:6426ecdcf2f43017fa9189c9038cb2abd203fda70e2f823854acdd47e84be1fd
BLAZE_VERSION=1.11.0
# Empreinte de l'IMAGE publiee, relevee le 2026-10-08 (docker image inspect samply/blaze:1.11.0 --format '{{index .RepoDigests 0}}').
# Le module complementaire se construit FROM cette image, epinglee par empreinte (ADR 0003) :
# c'est la seule base admise ; build/Dockerfile la recoit en argument, scripts/check_module.py la controle.
BLAZE_IMAGE_DIGEST=sha256:7b85c55df66122061abade67c715959b38508bb74bc28f62f262771e00f9a66c
# Empreinte du JAR /app/blaze-1.11.0-standalone.jar de l'image ci-dessus, relevee le
# 2026-10-08 par `scripts/outils.sh jar` (docker run --rm --entrypoint cat <image> <jar> | sha256sum).
# Le module complementaire se teste et se construit CONTRE ce jar (ADR 0003).
BLAZE_JAR_SHA256=6dc6848dc8a11664f75b367fdcdd9b2fc23b8295e3431ccbbabec252bee10058
# Branche stable nginx. REPRISE de fhir-platform (releve du 2026-08-02), NON
# reverifiee le 2026-10-07 : a relever avant le premier deploiement.
NGINX_VERSION=1.30.4
# Empreinte de l'IMAGE nginxinc/nginx-unprivileged:${NGINX_VERSION} (index multi-architecture), relevee le 2026-10-17
# sur le registre, deux sources concordantes :
#   curl -sI -H "Authorization: Bearer $(curl -s 'https://auth.docker.io/token?service=registry.docker.io&scope=repository:nginxinc/nginx-unprivileged:pull' | jq -r .token)" -H 'Accept: application/vnd.oci.image.index.v1+json' https://registry-1.docker.io/v2/nginxinc/nginx-unprivileged/manifests/1.30.4 | grep -i docker-content-digest
#   curl -s https://hub.docker.com/v2/repositories/nginxinc/nginx-unprivileged/tags/1.30.4 | jq -r .digest
# Le chart la DERIVE (kubernetes/chart/deriver.sh) : aucune empreinte ne s'ecrit sous kubernetes/.
NGINX_IMAGE_DIGEST=sha256:a5866218f05961c7651a4a4a18d9bd0e5e5b4b26aafffb334df3423948db3560
# Fournisseur OpenID — point ouvert 2 de l'ADR 0001 (Keycloak dans le chart, ou
# fournisseur externe). Non releve.
# KEYCLOAK_VERSION=
# Validateur externe et serveur de terminologie — point ouvert 1. Non releves.
# EXTERN_VALIDATOR_VERSION=

# --- Outillage ---
# Generateur Synthea — tag repris de fhir-platform (releve du 2026-08-02), reverifie
# le 2026-10-10 : asset synthea-with-dependencies.jar present (api.github.com
# releases/tags/v4.0.0). Execution : conteneur local construit a la demande,
# image de generation du jeu de reference (ADR 0007, point ouvert 7 de l'ADR 0001 tranche).
SYNTHEA_VERSION=v4.0.0
# Empreinte du jar epingle ci-dessus, releve le 2026-10-10 :
#   curl -fsSL https://github.com/synthetichealth/synthea/releases/download/v4.0.0/synthea-with-dependencies.jar | sha256sum
# Non publiee par l'editeur (la release ne porte pas de fichier d'empreintes) : le Dockerfile refuse un jar qui en diffère.
SYNTHEA_JAR_SHA256=ed43c20ad40ba5c3bc724503a5af032715fe3c491620b766148e7c2361e6ecc1
SYNTHEA_JAVA_BASE_TAG=21.0.11_10-jre
PYTHON_VERSION=3.11.15
# blazectl (Samply) — chargement du jeu de reference sur le serveur (`blazectl upload`, ADR 0007).
# Derniere publication au 2026-10-10 (curl -s https://api.github.com/repos/samply/blazectl/releases?per_page=1) : v1.5.1, 2026-10-05.
# Empreinte du BINAIRE linux-amd64, publiee dans le SBOM de la release (blazectl-linux-amd64-sbom.spdx.json,
# paquet « blazectl ») et relevee au telechargement le 2026-10-10 (sha256sum du binaire extrait) : scripts/outils.sh refuse un binaire qui en diffère.
BLAZECTL_VERSION=1.5.1
BLAZECTL_LINUX_AMD64_SHA256=22c7e5cbcb5808cd752c1922d8daa6f4c50eaa4efbdd7d1454517880059f8f3b

# --- Poste de developpement du module complementaire (scripts/outils.sh, ADR 0004) ---
# JDK : celui de l'image publiee (`docker image inspect samply/blaze:1.11.0`, JAVA_VERSION=jdk-25.0.3+9,
# releve le 2026-10-08), pour que les tests tournent sur la machine virtuelle qui sert.
JDK_VERSION=25.0.3+9
# Derniere publication au 2026-10-08 (curl -s https://api.github.com/repos/<depot>/releases?per_page=1) :
CLOJURE_CLI_VERSION=1.12.6.1673
CLJ_KONDO_VERSION=2026.08.04
CLOJURE_LSP_VERSION=2026.07.06-14.34.19
CLJFMT_VERSION=0.16.6

# --- Cluster kind local (ADR 0002) ---
# Image de la sonde reseau du controle reseau M6 : alpine, branche stable 3.24,
# derniere etiquette de patch relevee le 2026-10-13 (curl -s 'https://hub.docker.com/v2/repositories/library/alpine/tags?page_size=100&name=3.' ;
# 3.24.2, publiee le 2026-09-18). Pas d'empreinte : point ouvert 8 de l'ADR 0001.
SONDE_ALPINE_VERSION=3.24.2
# kind : derniere publication au 2026-10-07 (curl -s https://api.github.com/repos/kubernetes-sigs/kind/releases?per_page=1).
# Image de noeud : kindest/node:v${KUBECTL_VERSION}, etiquette verifiee presente le 2026-10-07.
KIND_VERSION=0.33.0
# Empreinte sha256 de kind-linux-amd64 v${KIND_VERSION}, relevee le 2026-10-16 : telechargement
# du binaire (sha256sum) = fichier publie kind-linux-amd64.sha256sum de la release (curl -fsSL <release>/kind-linux-amd64.sha256sum).
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d

# --- Cluster Kubernetes a trois VM ---
# REPRIS de fhir-platform avec leurs releves (2026-09-21 a 2026-10-03), NON
# reverifies le 2026-10-07. Retires : CloudNativePG, greffon Barman, cert-manager,
# MinIO, pilote CSI NFS, JDK du filtre de trace, OpenTelemetry, Jaeger — tous
# propres a la pile PostgreSQL / HAPI.
# Instantane glissant de l'image cloud Debian 13 : il EXPIRE, son absence doit
# rendre un refus net.
DEBIAN_CLOUD_IMAGE=20260914-2601
K8S_MINOR=1.35
KUBECTL_VERSION=1.35.8
HELM_VERSION=3.22.0
CILIUM_VERSION=1.20.2
# Versions de CHART Helm, pas d'application.
METALLB_VERSION=0.16.1
INGRESS_NGINX_VERSION=4.15.1
# Fournisseur de StorageClass du cluster (local-path) : attache le volume a son
# noeud — point ouvert 3 de l'ADR 0001.
LOCAL_PATH_PROVISIONER_VERSION=0.0.34

# Version du chart Helm de ce depot, derivee dans Chart.yaml, jamais saisie.
CHART_VERSION=0.1.0

# --- Moteur SQL embarque de $sqlquery-run (F-039, ADR 0014, T-112) ---
# org.duckdb/duckdb_jdbc : derniere version publiee au 2026-10-27 (<release> de maven-metadata.xml, lastUpdated 20261021140730) :
#   curl -sL https://repo1.maven.org/maven2/org/duckdb/duckdb_jdbc/maven-metadata.xml | grep '<release>'
# Jar telecharge : sha1 identique au fichier .jar.sha1 du depot Maven, 79362050 octets, 0 dependance declaree (.pom).
DUCKDB_JDBC_VERSION=2.0.0.0
# Empreinte sha256 du jar Maven ci-dessus, relevee le 2026-10-27 (T-116), trois sources concordantes :
#   sha256sum ~/.m2/repository/org/duckdb/duckdb_jdbc/2.0.0.0/duckdb_jdbc-2.0.0.0.jar
#   curl -sL https://repo1.maven.org/maven2/org/duckdb/duckdb_jdbc/2.0.0.0/duckdb_jdbc-2.0.0.0.jar.sha256
#   curl -sL https://repo1.maven.org/maven2/org/duckdb/duckdb_jdbc/2.0.0.0/duckdb_jdbc-2.0.0.0.jar | sha256sum
# build/Dockerfile la verifie (ADD --checksum) : une empreinte qui differe fait echouer `make image`.
DUCKDB_JDBC_SHA256=5170daa90a43296705127ef3c80834ba1cd275ec9d765a9f7eee346ab0087186
# IG SQL on FHIR (F-039, T-119) : version visee (ADR 0005) et sha256 du package.tgz releve le 2026-10-27 :
#   curl -sL https://build.fhir.org/ig/FHIR/sql-on-fhir-v2/package.tgz | sha256sum
# Le paquet de build.fhir.org est celui de la construction courante : une empreinte qui differe signale une nouvelle construction.
SQL_ON_FHIR_IG_VERSION=2.1.0-pre
SQL_ON_FHIR_IG_SHA256=d559b9d1f2b783b9b0143e8b14a58ce28f1f39b3bc015c200d39ebb0785b2361
